<Application x:Class="InputSync.UI.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <SolidColorBrush x:Key="CanvasBrush" Color="#FFFFFFFF" />
        <SolidColorBrush x:Key="SurfaceBrush" Color="#FFF4F4F4" />
        <SolidColorBrush x:Key="SurfaceHoverBrush" Color="#FFE8E8E8" />
        <SolidColorBrush x:Key="InkBrush" Color="#FF161616" />
        <SolidColorBrush x:Key="MutedInkBrush" Color="#FF525252" />
        <SolidColorBrush x:Key="BorderBrush" Color="#FFC6C6C6" />
        <SolidColorBrush x:Key="AccentBrush" Color="#FF0F62FE" />
        <SolidColorBrush x:Key="AccentPressedBrush" Color="#FF002D9C" />
        <SolidColorBrush x:Key="SuccessBrush" Color="#FF198038" />
        <SolidColorBrush x:Key="WarningBrush" Color="#FFF1C21B" />
        <SolidColorBrush x:Key="DangerBrush" Color="#FFDA1E28" />
        <SolidColorBrush x:Key="OnDarkBrush" Color="#FFFFFFFF" />

        <Style TargetType="Window">
            <Setter Property="FontFamily" Value="Segoe UI, Arial" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
            <Setter Property="Background" Value="{StaticResource CanvasBrush}" />
        </Style>
        <Style TargetType="Button">
            <Setter Property="MinHeight" Value="40" />
            <Setter Property="Padding" Value="16,8" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="MinHeight" Value="40" />
            <Setter Property="Padding" Value="8,4" />
            <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="MinHeight" Value="40" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
    </Application.Resources>
</Application>
